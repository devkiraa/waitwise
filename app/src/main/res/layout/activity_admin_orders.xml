<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminOrdersRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ww_background"
    android:orientation="vertical">

    <!-- Top AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBackAdminOrders"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Kitchen &amp; Orders"
            android:textColor="@color/ww_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <!-- Search Token / Order ID -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            app:boxBackgroundColor="@color/ww_surface"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/ww_border"
            app:boxStrokeWidth="1dp"
            app:hintEnabled="false"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="@color/ww_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchAdminOrders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Search Token #, Order ID or item..."
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:singleLine="true"
                android:textColor="@color/ww_text_primary"
                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Status Filter Buttons -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterOrdersAll"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="All Orders"
                    android:textColor="@color/ww_surface"
                    android:textSize="12sp"
                    app:backgroundTint="@color/ww_primary"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterOrdersActive"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:text="Kitchen (Pending)"
                    android:textColor="@color/ww_text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/ww_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterOrdersReady"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:text="Ready for Pickup"
                    android:textColor="@color/ww_text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/ww_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterOrdersCompleted"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:text="Collected"
                    android:textColor="@color/ww_text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/ww_border" />

            </LinearLayout>

        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvAdminOrdersCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="0 orders"
            android:textColor="@color/ww_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerAdminOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            app:shimmer_auto_start="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/item_skeleton_order" />
                <include layout="@layout/item_skeleton_order" />
                <include layout="@layout/item_skeleton_order" />

            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyAdminOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No orders found"
                android:textColor="@color/ww_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Incoming pre-orders from customers will appear here in real time."
                android:textColor="@color/ww_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Orders List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAdminOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp" />

    </FrameLayout>

</LinearLayout>
