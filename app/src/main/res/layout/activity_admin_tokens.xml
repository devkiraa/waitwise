<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ww_background"
    android:orientation="vertical">

    <!-- Top AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackAdminTokens"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="←"
            android:textColor="@color/ww_text_primary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Token Counter"
            android:textColor="@color/ww_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <!-- Status Filter Buttons -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterTokensActive"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="In Kitchen / Prep"
                    android:textColor="@color/ww_surface"
                    android:textSize="12sp"
                    app:backgroundTint="@color/ww_primary"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterTokensReady"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:text="Ready for Pickup"
                    android:textColor="@color/ww_text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/ww_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterTokensAll"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:text="All Tokens"
                    android:textColor="@color/ww_text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/ww_border" />

            </LinearLayout>

        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvAdminTokensCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="0 tokens"
            android:textColor="@color/ww_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progressBarAdminTokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/ww_primary" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyAdminTokens"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No tokens found"
                android:textColor="@color/ww_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Active pickup tokens will appear here as orders are placed."
                android:textColor="@color/ww_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Tokens List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAdminTokens"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp" />

    </FrameLayout>

</LinearLayout>
