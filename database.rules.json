{
  "rules": {
    "menu": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && (!data.exists() && (!newData.hasChild('role') || newData.child('role').val() === 'customer') || (data.exists() && (!newData.hasChild('role') || newData.child('role').val() === data.child('role').val())))))"
      }
    },
    "carts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "orders": {
      ".read": "auth != null",
      ".indexOn": ["userId", "createdAt", "orderStatus"],
      "$orderId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.child('userId').val() === auth.uid && newData.child('orderStatus').val() === 'PLACED'))",
        ".validate": "newData.hasChildren(['userId', 'tokenNumber', 'subtotal', 'paymentMethod', 'orderStatus', 'createdAt'])"
      }
    },
    "tokens": {
      "lastToken": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
